# Grafana datasource provisioning -- managed by Ansible
apiVersion: 1

# Remove any existing same-name datasource first so the pinned uid below is
# applied cleanly. Grafana cannot change the uid of an existing datasource.
deleteDatasources:
  - name: Prometheus
    orgId: 1

datasources:
  - name: Prometheus
    type: prometheus
    uid: prometheus
    access: proxy
    url: "http://127.0.0.1:{{ p2poolv2_prometheus_port }}"
    isDefault: true
    editable: false
    jsonData:
      httpMethod: POST
      timeInterval: "{{ p2poolv2_prometheus_scrape_interval }}"
