# Prometheus config -- managed by Ansible

global:
  scrape_interval: {{ p2poolv2_prometheus_scrape_interval }}

scrape_configs:
{% for instance in p2poolv2_instances if instance.enabled | default(true) %}
  # p2poolv2 {{ instance.instance }} instance
  - job_name: "p2pool-{{ instance.instance }}"
    metrics_path: "/metrics"
    static_configs:
      - targets:
          - "127.0.0.1:{{ instance.api_port }}"
        labels:
          p2poolv2_instance: "{{ instance.instance }}"
{% if instance.api_auth_user | default('') | length > 0 %}
    basic_auth:
      username: "{{ instance.api_auth_user }}"
      password: "{{ instance.api_auth_pass }}"
{% endif %}
{% endfor %}
{% for extra in p2poolv2_prometheus_extra_targets %}

  - job_name: "{{ extra.job_name }}"
    static_configs:
      - targets:
          - "{{ extra.target }}"
{% endfor %}
